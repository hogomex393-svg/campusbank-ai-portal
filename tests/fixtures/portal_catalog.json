            {
              "value": "debit_card",
              "label": "借记卡"
            },
            {
              "value": "credit_card",
              "label": "信用卡"
            }
          ],
          "required": true
        },
        {
          "name": "linked_product",
          "label": "配套账户",
          "type": "select",
          "options": [
            {
              "value": "student_account",
              "label": "学生账户"
            },
            {
              "value": "everyday_account",
              "label": "日常账户"
            }
