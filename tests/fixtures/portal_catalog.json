  "services": [
    {
      "id": "open_account",
      "category": "accounts",
      "title": "在线开户申请",
      "en": "Open an account",
      "description": "选择账户，核对材料，登记演示申请。",
      "icon": "wallet",
      "fields": [
        {
          "name": "product",
          "label": "账户类型",
          "type": "select",
          "options": [
            {
              "value": "student_account",
              "label": "学生账户 · 无月费"
            },
            {
              "value": "everyday_account",
              "label": "日常账户 · 月费 £3"
            }
          ],
          "required": true
        },
        {
          "name": "applicant",
          "label": "申请人称呼（演示）",
          "type": "text",
          "options": [],
          "required": true
        },
        {
          "name": "channel",
          "label": "办理渠道",
          "type": "select",
          "options": [
            {
              "value": "online",
              "label": "网上申请"
            },
            {
              "value": "branch",
              "label": "网点办理"
            }
          ],
          "required": true
        },
        {
          "name": "documents_ready",
          "label": "已了解身份证件、地址证明及产品材料要求",
          "type": "checkbox",
          "options": [],
          "required": true
        }
      ],
      "notice": "本窗口登记课程演示申请；提交后等待审核，不会开立真实银行账户。"
    },
    {
      "id": "apply_card",
