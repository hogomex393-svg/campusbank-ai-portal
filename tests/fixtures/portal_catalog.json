            {
              "value": "replace",
              "label": "申请补卡（演示费 £5）"
            }
          ],
          "required": true
        },
        {
          "name": "note",
          "label": "情况说明",
          "type": "textarea",
          "options": [],
          "required": false
        }
      ],
      "notice": "不会操作真实银行卡，也不需要填写卡号或 PIN。"
    },
