# Set these in Railway's private service variables; this file contains no secrets.
BANKBOT_DEPLOYMENT=cloud
BANKBOT_DB_PATH=/data/portal.sqlite3
# Attach a volume at /data before deployment. Do not scale above one instance.
# Public URL can be inferred from RAILWAY_PUBLIC_DOMAIN after Generate Domain.
BANKBOT_PUBLIC_URL=
BANKBOT_BOOTSTRAP_CODE=
BANKBOT_TEST_ACCESS_CODE=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
BANKBOT_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1600
BANKBOT_OPEN_STAFF_TESTING=false
