# Optional Qwen configuration. Copy the exact endpoint from your Model Studio console.
# Keys and endpoints must belong to the same region. Do not paste a DeepSeek key here.
LLM_PROVIDER=qwen
LLM_API_KEY=
# Replace this with your actual workspace-specific /compatible-mode/v1 endpoint.
LLM_BASE_URL=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_MAX_TOKENS=1600
BANKBOT_TIMEOUT_SECONDS=45
BANKBOT_OPEN_STAFF_TESTING=false
