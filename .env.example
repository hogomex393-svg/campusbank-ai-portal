# Optional online model configuration. Copy to .env; never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model used in the recorded online verification; choose one available to your account.
DEEPSEEK_MODEL=deepseek-v4-pro
BANKBOT_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1600
# Enable only for a controlled demo. This opens staff access to application records.
BANKBOT_OPEN_STAFF_TESTING=false
BANKBOT_MAX_TOOL_ROUNDS=3
BANKBOT_HISTORY_TURNS=6
